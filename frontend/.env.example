# Frontend build-time environment variables (Vite).
# Copy to .env and fill in. Vite only exposes vars prefixed with VITE_.

# Sentry browser DSN (public client key). Leave blank to disable monitoring.
VITE_SENTRY_DSN=

# API base URL. Local dev can leave this blank (Vite proxy forwards /api).
# Production (Vercel): set to your Render backend URL.
VITE_API_URL=https://bjp-mebership.onrender.com
