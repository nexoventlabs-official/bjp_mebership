# ── BJP Local Body Application backend ─────────────────────────────
# Copy to .env and fill in real values.
NODE_ENV=development
PORT=5000

# Frontend origin allowed for CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:3000

# ── DB1: Voter Roll — READ-ONLY ───────────────────────────────────
MONGO_VOTER_URL=
MONGO_VOTER_DB_NAME=voter_db

# ── DB2: Applications store — read/write ──────────────────────────
MONGO_APP_URL=
MONGO_APP_DB_NAME=bjp_localbody

# ── 2Factor SMS OTP ───────────────────────────────────────────────
SMS_API_KEY=
SMS_TEMPLATE_NAME=OTP1

# ── Admin panel login ─────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
